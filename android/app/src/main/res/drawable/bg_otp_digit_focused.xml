<?xml version="1.0" encoding="utf-8"?>
<!-- The active code box: a 2 dp ink outline to show focus, the one outline the design allows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_2" />
    <corners android:radius="@dimen/radius_thumb" />
    <stroke
        android:width="2dp"
        android:color="@color/ink" />
</shape>
