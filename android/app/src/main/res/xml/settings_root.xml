<?xml version="1.0" encoding="utf-8"?>
<!-- Settings list. Groups and titles only; the keys are unchanged. Rows get their look in SettingsFragment. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_group_model">

        <!-- Lane M1: opens the Model screen; the summary is the current model. Not stored. -->
        <Preference
            android:key="model_choice"
            android:title="@string/pref_model_choice_title"
            android:persistent="false" />

        <PreferenceScreen
            android:key="subscreen_profile"
            android:title="@string/pref_profile_title"
            android:summary="@string/pref_profile_summary_none">

            <Preference
                android:key="provider_profile"
                android:title="@string/profile_dialog_title"
                android:summary="@string/pref_profile_summary_none" />

            <ListPreference
                android:key="api_provider"
                android:title="@string/pref_provider_title"
                android:summary="%s"
                android:entries="@array/api_providers"
                android:entryValues="@array/api_provider_values"
                android:defaultValue="openai" />

            <EditTextPreference
                android:key="api_key"
                android:title="@string/pref_api_key_title"
                android:summary="@string/pref_masked_summary"
                android:inputType="textPassword"
                android:defaultValue="" />

            <EditTextPreference
                android:key="model"
                android:title="@string/pref_model_title"
                android:summary="@string/pref_not_set"
                android:inputType="text"
                android:defaultValue="gpt-5.5" />

            <EditTextPreference
                android:key="base_url"
                android:title="@string/pref_base_url_title"
                android:summary="@string/pref_not_set"
                android:inputType="textUri"
                android:defaultValue="https://api.openai.com/v1" />

        </PreferenceScreen>

        <Preference
            android:key="sign_in"
            android:title="@string/pref_sign_in_title"
            android:summary="@string/pref_sign_in_summary" />

        <Preference
            android:key="voice_settings"
            android:title="@string/voice_settings_title"
            android:summary="@string/voice_settings_pref_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/suggestions_group">
        <SwitchPreference
            android:key="suggest_from_notifications"
            android:title="@string/suggestions_title"
            android:persistent="false"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_group_connection">

        <Preference
            android:key="backend_status"
            android:title="@string/pref_backend_title"
            android:selectable="true"
            android:summary="@string/pref_backend_detecting" />

        <Preference
            android:key="backend_revoke"
            android:title="@string/pref_revoke_title"
            android:summary="@string/pref_revoke_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_group_limits">

        <EditTextPreference
            android:key="max_steps"
            android:title="@string/pref_max_steps_title"
            android:inputType="number"
            android:defaultValue="100" />

        <SwitchPreference
            android:key="debug_mode"
            android:title="@string/pref_debug_mode_title"
            android:summary="@string/pref_debug_mode_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_group_blocked">

        <Preference
            android:key="manage_blacklist"
            android:title="@string/pref_app_blacklist"
            android:summary="@string/pref_app_blacklist_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_group_data">

        <!-- No key on purpose: the brief allows no new keys. The class opens the history screen. -->
        <ai.opencyclon.HistoryPreference
            android:title="@string/pref_history_title"
            android:summary="@string/pref_history_summary"
            android:persistent="false" />

        <Preference
            android:key="manage_memory"
            android:title="@string/btn_manage_memory"
            android:summary="@string/pref_manage_memory_summary" />

        <Preference
            android:key="version_info"
            android:title="@string/pref_version_title"
            android:selectable="false"
            android:summary="1.0" />

    </PreferenceCategory>

</PreferenceScreen>
