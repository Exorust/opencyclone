<?xml version="1.0" encoding="utf-8"?>
<!-- Memory: title at the top left with a pale "Add", a search field, then the remembered facts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memory_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_page"
    android:paddingEnd="@dimen/margin_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_block"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/memory_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/memory_title"
            android:textAppearance="@style/TextAppearance.App.Greeting"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btn_add_memory"
            style="@style/Widget.App.Button.Pale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/memory_add" />
    </LinearLayout>

    <EditText
        android:id="@+id/edit_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/gap_heading"
        android:layout_marginBottom="@dimen/gap_heading"
        android:background="@drawable/bg_pill_surface"
        android:hint="@string/memory_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_3" />

    <TextView
        android:id="@+id/memory_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/memory_empty"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/ink_2"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_memories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never" />
</LinearLayout>
