<?xml version="1.0" encoding="utf-8"?>
<!-- Shared-app card on the recipient's phone (UI.md 4 and 5.11 with sections 9 and 10). Cool wash and the
     card's edge band are set in code; the card is centred vertically in the upper half. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/received_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/margin_page"
    android:paddingEnd="@dimen/margin_page">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/received_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <LinearLayout
        android:id="@+id/received_card"
        style="@style/Widget.App.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_shared"
        app:layout_constraintBottom_toTopOf="@id/received_middle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/received_glyph"
                android:layout_width="@dimen/icon_notification"
                android:layout_height="@dimen/icon_notification"
                android:layout_marginEnd="@dimen/padding_notification"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/received_shared_with_you"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_now"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>

        <TextView
            android:id="@+id/received_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_notification"
            android:text="@string/received_text"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <LinearLayout
            android:id="@+id/received_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_heading"
            android:background="@drawable/bg_row_surface2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/padding_card">

            <ImageView
                android:id="@+id/received_app_icon"
                android:layout_width="@dimen/icon_tile_large"
                android:layout_height="@dimen/icon_tile_large"
                android:layout_marginEnd="@dimen/padding_card"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/received_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.Heading" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/received_shield"
                        android:layout_width="@dimen/icon_glyph"
                        android:layout_height="@dimen/icon_glyph"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield_16"
                        android:tint="@color/ok" />

                    <TextView
                        android:id="@+id/received_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/received_checked"
                        android:textAppearance="@style/TextAppearance.App.Label" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/received_findings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_notification"
            android:textAppearance="@style/TextAppearance.App.Small"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/received_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_shared"
            android:orientation="horizontal">

            <Button
                android:id="@+id/received_open"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/gap_buttons"
                android:text="@string/ui_open" />

            <Button
                android:id="@+id/received_dismiss"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:text="@string/ui_not_now" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
