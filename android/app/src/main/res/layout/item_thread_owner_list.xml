<?xml version="1.0" encoding="utf-8"?>
<!-- Owner bubble, list (UI.md section 4): small "You" above at the right, bubble-you, one paragraph for each line (added in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical">

    <TextView
        android:id="@+id/owner_you"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_chip"
        android:text="@string/ui_you"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <LinearLayout
        android:id="@+id/owner_lines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_you"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_bubble_h"
        android:paddingEnd="@dimen/padding_bubble_h"
        android:paddingTop="@dimen/padding_bubble_v"
        android:paddingBottom="@dimen/padding_bubble_v" />
</LinearLayout>
