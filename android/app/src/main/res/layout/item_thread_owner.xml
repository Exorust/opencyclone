<?xml version="1.0" encoding="utf-8"?>
<!-- Owner bubble, single (UI.md section 4): ink, on-ink body text, radius 20 dp, right aligned, at most 80% wide (set in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/owner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_ink"
        android:paddingStart="@dimen/padding_bubble_h"
        android:paddingEnd="@dimen/padding_bubble_h"
        android:paddingTop="@dimen/padding_bubble_v"
        android:paddingBottom="@dimen/padding_bubble_v"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/on_ink" />
</FrameLayout>
