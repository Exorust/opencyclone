<?xml version="1.0" encoding="utf-8"?>
<!-- Text-field row (UI.md 5.12): label above, the field on surface-2 with radius 16 dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_field"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_heading"
    android:orientation="vertical">

    <TextView
        android:id="@+id/field_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@+id/field_input"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <EditText
        android:id="@+id/field_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_chip"
        android:background="@drawable/bg_row_surface2"
        android:minHeight="52dp"
        android:paddingStart="@dimen/padding_card"
        android:paddingTop="@dimen/padding_notification"
        android:paddingEnd="@dimen/padding_card"
        android:paddingBottom="@dimen/padding_notification"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColorHint="@color/ink_3" />
</LinearLayout>
