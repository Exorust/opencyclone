<?xml version="1.0" encoding="utf-8"?>
<!--
  Contents of RunningPanelView (a vertical LinearLayout). UI.md section 10 and section 9 item 3:
  a header band in surface over a body in panel_body with one live preview, its caption, a pale "Stop",
  and one small line for each waiting task. The header band background is set in code (top corners only).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/running_panel_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_card"
        android:paddingEnd="@dimen/padding_card"
        android:paddingTop="@dimen/padding_notification"
        android:paddingBottom="@dimen/padding_notification"
        android:elevation="@dimen/elevation_card"
        android:outlineSpotShadowColor="#33000000"
        android:outlineAmbientShadowColor="#14000000">

        <TextView
            android:id="@+id/running_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/running_panel_title"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/ink"
            android:textFontWeight="600" />

        <ai.opencyclon.ui.widget.WordRevealTextView
            android:id="@+id/running_panel_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_panel_subtitle"
            android:textAppearance="@style/TextAppearance.App.Small" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/running_panel_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_body"
        android:orientation="vertical"
        android:padding="@dimen/padding_card">

        <LinearLayout
            android:id="@+id/running_panel_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ai.opencyclon.ui.widget.LivePreviewView
                    android:id="@+id/running_panel_preview"
                    android:layout_width="@dimen/preview_width"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/running_panel_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/gap_chip"
                    android:background="@drawable/bg_pill_surface"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:paddingStart="@dimen/gap_chip"
                    android:paddingEnd="@dimen/gap_chip"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textAppearance="@style/TextAppearance.App.Small"
                    android:textColor="@color/ink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_receipt"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/running_panel_icon"
                    android:layout_width="@dimen/icon_glyph"
                    android:layout_height="@dimen/icon_glyph"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/running_panel_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_chip"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.Small"
                    android:textColor="@color/ink"
                    android:textFontWeight="600" />
            </LinearLayout>

            <ai.opencyclon.ui.widget.WordRevealTextView
                android:id="@+id/running_panel_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.App.Small" />

            <Button
                android:id="@+id/running_panel_stop"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_receipt"
                android:contentDescription="@string/running_stop_description"
                android:text="@string/ui_stop" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/running_panel_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</merge>
