<?xml version="1.0" encoding="utf-8"?>
<!-- A plain secondary screen (UI.md 5.12): wash, title, optional lead sentence, rows, and a bottom bar for one primary and one pale button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/screen_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/screen_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_page"
            android:paddingTop="@dimen/header_top"
            android:paddingEnd="@dimen/margin_page"
            android:paddingBottom="@dimen/gap_block">

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.App.Greeting" />

            <TextView
                android:id="@+id/screen_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_heading"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/screen_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/screen_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margin_page"
        android:paddingTop="@dimen/gap_chip"
        android:paddingEnd="@dimen/margin_page"
        android:paddingBottom="@dimen/gap_block"
        android:visibility="gone">

        <Button
            android:id="@+id/screen_primary"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_buttons"
            android:visibility="gone" />

        <Button
            android:id="@+id/screen_pale"
            style="@style/Widget.App.Button.Pale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
