<?xml version="1.0" encoding="utf-8"?>
<!-- One installed app in the app search: icon 40 dp and the name in Body. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/app_row_icon"
        android:layout_width="@dimen/icon_card"
        android:layout_height="@dimen/icon_card"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/app_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_heading"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.App.Body" />
</LinearLayout>
