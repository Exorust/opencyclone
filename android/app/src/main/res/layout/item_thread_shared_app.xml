<?xml version="1.0" encoding="utf-8"?>
<!-- Shared-app card (UI.md section 4 with sections 9 and 10). The edge wash background is set in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/shared_card"
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_shared">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/shared_glyph"
                android:layout_width="@dimen/icon_notification"
                android:layout_height="@dimen/icon_notification"
                android:layout_marginEnd="@dimen/padding_notification"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/thread_shared_with_you"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <TextView
                android:id="@+id/shared_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label" />
        </LinearLayout>

        <TextView
            android:id="@+id/shared_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_notification"
            android:textAppearance="@style/TextAppearance.App.Heading" />

        <LinearLayout
            android:id="@+id/shared_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_heading"
            android:background="@drawable/bg_row_surface2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/padding_card">

            <ImageView
                android:id="@+id/shared_app_icon"
                android:layout_width="@dimen/icon_tile_large"
                android:layout_height="@dimen/icon_tile_large"
                android:layout_marginEnd="@dimen/padding_card"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shared_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.App.Heading" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/shared_shield"
                        android:layout_width="@dimen/icon_glyph"
                        android:layout_height="@dimen/icon_glyph"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield_16"
                        android:tint="@color/ok" />

                    <TextView
                        android:id="@+id/shared_checked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.App.Label" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shared_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_shared"
            android:orientation="horizontal">

            <Button
                android:id="@+id/shared_open"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/gap_buttons"
                android:text="@string/ui_open" />

            <Button
                android:id="@+id/shared_not_now"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:text="@string/ui_not_now" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
