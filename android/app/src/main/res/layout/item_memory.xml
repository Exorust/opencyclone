<?xml version="1.0" encoding="utf-8"?>
<!-- One remembered fact: surface_2 row, radius 16 dp, 8 dp below. Key and value in body, details in small. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_row_surface2"
    android:orientation="vertical"
    android:padding="@dimen/padding_card">

    <TextView
        android:id="@+id/text_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/ink"
        android:textFontWeight="500" />

    <TextView
        android:id="@+id/text_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/text_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.App.Small"
        android:textColor="@color/ink_2" />
</LinearLayout>
