<?xml version="1.0" encoding="utf-8"?>
<!-- Draft page (F16.2): the widget at its real size with live data, the draft line, the hint or the
     change progress, a question when a change needs more sources, the text field, Discard and Save. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draft_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_page"
    android:paddingTop="@dimen/header_top"
    android:paddingEnd="@dimen/margin_page"
    android:paddingBottom="@dimen/gap_heading">

    <FrameLayout
        android:id="@+id/draft_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/draft_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_block"
        android:text="@string/widgets_draft_label"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <TextView
        android:id="@+id/draft_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_chip"
        android:text="@string/widgets_draft_hint"
        android:textAppearance="@style/TextAppearance.App.Small" />

    <LinearLayout
        android:id="@+id/draft_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_block"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/draft_confirm_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Heading" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_heading"
            android:orientation="horizontal">

            <Button
                android:id="@+id/draft_confirm_yes"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/gap_buttons"
                android:text="@string/widgets_build_it" />

            <Button
                android:id="@+id/draft_confirm_no"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:text="@string/ui_not_now" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/draft_input"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_card"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/draft_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/widgets_type_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColorHint="@color/ink_3" />

        <ImageButton
            android:id="@+id/draft_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:contentDescription="@string/ui_send"
            android:src="@drawable/ic_chevron_16"
            android:tint="@color/primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_heading"
        android:orientation="horizontal">

        <Button
            android:id="@+id/draft_discard"
            style="@style/Widget.App.Button.Pale"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/gap_buttons"
            android:layout_weight="1"
            android:text="@string/widgets_discard" />

        <Button
            android:id="@+id/draft_save"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/widgets_save" />
    </LinearLayout>
</LinearLayout>
