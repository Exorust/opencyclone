<?xml version="1.0" encoding="utf-8"?>
<!--
  The app search of home mode (UI.md section 9 item 6): one text field in a surface pill and a plain list of
  installed apps. Inflated only while open, over the page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_page"
    android:paddingEnd="@dimen/margin_page">

    <EditText
        android:id="@+id/app_search_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_heading"
        android:background="@drawable/bg_pill_surface"
        android:contentDescription="@string/roles_app_search_field"
        android:elevation="@dimen/elevation_card"
        android:hint="@string/roles_app_search_field"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="48dp"
        android:paddingStart="@dimen/padding_bubble_h"
        android:paddingEnd="@dimen/padding_bubble_h"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColorHint="@color/ink_3" />

    <TextView
        android:id="@+id/app_search_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_block"
        android:text="@string/roles_app_search_empty"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/ink_2"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_search_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_chip"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
