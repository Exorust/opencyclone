<?xml version="1.0" encoding="utf-8"?>
<!-- Result card (UI.md 5.10): surface card, built app tile, title in Body weight 500, caption in Small. A tap opens the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/result_card"
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/result_icon"
            android:layout_width="@dimen/icon_card"
            android:layout_height="@dimen/icon_card"
            android:layout_marginEnd="@dimen/padding_notification"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textFontWeight="500" />

            <TextView
                android:id="@+id/result_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Small" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
