<?xml version="1.0" encoding="utf-8"?>
<!-- Helper setup and pairing. Step title in heading at the top left; code boxes and number pad for the code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_page"
        android:paddingTop="@dimen/gap_block"
        android:paddingEnd="@dimen/margin_page"
        android:paddingBottom="@dimen/gap_block">

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_heading"
            android:text="@string/setup_choose_title"
            android:textAppearance="@style/TextAppearance.App.Heading"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/setup_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_block"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/ink" />

        <ProgressBar
            android:id="@+id/setup_progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="@dimen/gap_heading"
            android:indeterminateTint="@color/ink_2"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/setup_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_heading"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/setup_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="@color/ink" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/setup_otp_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_pair_split_label"
            android:textAppearance="@style/TextAppearance.App.Heading"
            android:textColor="@color/ink"
            android:visibility="gone" />

        <ai.opencyclon.backend.OtpDigitBox
            android:id="@+id/setup_otp_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/gap_heading"
            android:visibility="gone" />

        <ai.opencyclon.backend.NumberPadView
            android:id="@+id/setup_number_pad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/gap_heading"
            android:visibility="gone" />

        <Button
            android:id="@+id/setup_action_button"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_use_adb" />

        <Button
            android:id="@+id/setup_secondary_button"
            style="@style/Widget.App.Button.Pale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_use_shizuku"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
