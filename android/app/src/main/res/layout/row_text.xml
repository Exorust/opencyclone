<?xml version="1.0" encoding="utf-8"?>
<!-- Text row (UI.md 5.12): surface-2, radius 16 dp; title, optional small line, optional trailing text, chevron, or pale pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_chip"
    android:background="@drawable/bg_row_surface2"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_card"
    android:paddingTop="@dimen/padding_notification"
    android:paddingEnd="@dimen/padding_card"
    android:paddingBottom="@dimen/padding_notification">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:id="@+id/row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.App.Small"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_chip"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="@dimen/icon_glyph"
        android:layout_height="@dimen/icon_glyph"
        android:layout_marginStart="@dimen/gap_chip"
        android:contentDescription="@string/screens_open"
        android:src="@drawable/ic_chevron_16"
        android:visibility="gone" />

    <Button
        android:id="@+id/row_action"
        style="@style/Widget.App.Button.Pale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_chip"
        android:minHeight="48dp"
        android:paddingStart="@dimen/padding_card"
        android:paddingEnd="@dimen/padding_card"
        android:visibility="gone" />
</LinearLayout>
