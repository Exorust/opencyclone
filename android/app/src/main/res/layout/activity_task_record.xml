<?xml version="1.0" encoding="utf-8"?>
<!--
  The record of one task (F15.2): the task's rows drawn as in the home thread, read-only. Above the list only the
  system bar padding; below it one primary button "Ask again" at full width. Insets are applied in code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/record_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <!-- One RecyclerView of thread rows for each part, with the line under an answered approval between. -->
            <LinearLayout
                android:id="@+id/record_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingTop="@dimen/gap_block"
                android:paddingBottom="@dimen/gap_block" />
        </ScrollView>

        <TextView
            android:id="@+id/record_gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_page"
            android:layout_marginTop="@dimen/header_top"
            android:layout_marginEnd="@dimen/margin_page"
            android:text="@string/hist_record_gone"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/ink_2"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/record_ask_again"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_page"
        android:layout_marginTop="@dimen/gap_chip"
        android:layout_marginEnd="@dimen/margin_page"
        android:layout_marginBottom="@dimen/gap_block"
        android:text="@string/hist_ask_again" />
</LinearLayout>
