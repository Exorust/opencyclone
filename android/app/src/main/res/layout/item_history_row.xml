<?xml version="1.0" encoding="utf-8"?>
<!--
  One task on the history page. No divider. Title in Body, one line, the matching part in weight 600; under it in
  Small: time, " · ", the status word. Up to three app icons, 16 dp, at the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hist_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_page"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/margin_page"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hist_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/hist_row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Small"
            android:textColor="@color/ink_2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hist_row_icons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal" />
</LinearLayout>
