<?xml version="1.0" encoding="utf-8"?>
<!--
  Live view: the hidden display full screen, a quiet glow while the phone works, a state pill at the bottom right,
  and a bottom panel with pale pills ("Back", "Hide", "Take over", "Stop"). Result banners are surface cards.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- SurfaceView renders VD content full-screen -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <EditText
        android:id="@+id/takeover_keyboard_proxy"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:alpha="0"
        android:background="@null"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:imeOptions="flagNoExtractUi"
        android:textColor="@color/ink" />

    <!-- Quiet glow border: shows when the phone is working on the hidden display -->
    <ai.opencyclon.ui.GlowBorderView
        android:id="@+id/glow_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Touch interceptor: blocks touches in VIEW mode, invisible -->
    <View
        android:id="@+id/touch_interceptor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Short banner: a surface card with body text -->
    <TextView
        android:id="@+id/status_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="@dimen/margin_page"
        android:layout_marginEnd="@dimen/margin_page"
        android:layout_marginBottom="80dp"
        android:background="@drawable/banner_background"
        android:elevation="@dimen/elevation_card"
        android:paddingHorizontal="@dimen/padding_card"
        android:paddingVertical="12dp"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/ink"
        android:visibility="gone" />

    <!-- Result: a surface card with the outcome word, the phone's sentence, and pale pills -->
    <LinearLayout
        android:id="@+id/result_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_background"
        android:elevation="@dimen/elevation_card"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_card"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/result_icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/view_state_done"
                android:textAppearance="@style/TextAppearance.App.Small"
                android:textColor="@color/ink_2" />

            <TextView
                android:id="@+id/btn_result_close"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/view_close"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/ink_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/result_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="@dimen/padding_card"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_card"
            android:paddingBottom="@dimen/padding_card">

            <Button
                android:id="@+id/btn_result_back"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vd_btn_back" />

            <Button
                android:id="@+id/btn_result_takeover"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vd_btn_take_over" />

            <Button
                android:id="@+id/btn_result_stop"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vd_btn_stop" />
        </LinearLayout>
    </LinearLayout>

    <!-- State pill: one word for what the phone is doing; a tap opens the controls -->
    <FrameLayout
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/margin_page"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_pill_surface"
        android:clickable="true"
        android:elevation="@dimen/elevation_card"
        android:focusable="true">

        <TextView
            android:id="@+id/fab_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/view_state_running"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/ink"
            android:textFontWeight="500" />
    </FrameLayout>

    <!-- Expandable bottom panel -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_background"
        android:elevation="@dimen/elevation_card"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:visibility="gone">

        <!-- Ask-user section: question + input (conditionally visible) -->
        <LinearLayout
            android:id="@+id/ask_user_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/question_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:textAppearance="@style/TextAppearance.App.Heading"
                android:textColor="@color/ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <EditText
                    android:id="@+id/answer_input"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:hint="@string/vd_hint_answer"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingHorizontal="18dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_3" />

                <Button
                    android:id="@+id/btn_voice_answer"
                    style="@style/Widget.App.Button.Pale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/view_speak" />

                <Button
                    android:id="@+id/btn_send_answer"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/view_send" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/handoff_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/handoff_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/handoff_title"
                android:textAppearance="@style/TextAppearance.App.Heading"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/handoff_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/handoff_countdown_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/ink_2"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/handoff_pending_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_handoff_now"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/handoff_return_now" />

                <Button
                    android:id="@+id/btn_handoff_cancel"
                    style="@style/Widget.App.Button.Pale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_buttons"
                    android:text="@string/handoff_cancel_return" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/supplement_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/supplement_info"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/ink_2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <EditText
                    android:id="@+id/supplement_input"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:background="@drawable/input_background"
                    android:hint="@string/supplement_hint"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingHorizontal="18dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_3" />

                <Button
                    android:id="@+id/btn_send_supplement"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/view_send" />
            </LinearLayout>
        </LinearLayout>

        <!-- Space between the sections above and the control pills (no line) -->
        <View
            android:id="@+id/panel_divider"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:visibility="gone" />

        <!-- Control pills -->
        <LinearLayout
            android:id="@+id/control_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_card"
            android:paddingTop="4dp"
            android:paddingBottom="@dimen/padding_card">

            <Button
                android:id="@+id/btn_back"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vd_btn_back" />

            <Button
                android:id="@+id/btn_minimize"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/vd_cd_minimize"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vd_btn_minimize" />

            <Button
                android:id="@+id/btn_takeover"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.3"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vd_btn_take_over" />

            <Button
                android:id="@+id/btn_stop"
                style="@style/Widget.App.Button.Pale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vd_btn_stop" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
