<?xml version="1.0" encoding="utf-8"?>
<!--
  The type input (UI.md section 9 item 7): one text field in a surface pill above the keyboard, with the
  primary button "Send". Inflated only while the owner types, so the idle page has no text box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pill_surface"
    android:elevation="@dimen/elevation_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_bubble_h"
    android:paddingTop="@dimen/gap_chip"
    android:paddingEnd="@dimen/gap_chip"
    android:paddingBottom="@dimen/gap_chip">

    <EditText
        android:id="@+id/type_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:contentDescription="@string/home_type_field"
        android:importantForAutofill="no"
        android:imeOptions="actionSend"
        android:inputType="textCapSentences"
        android:minHeight="48dp"
        android:textAppearance="@style/TextAppearance.App.Body" />

    <Button
        android:id="@+id/type_send"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/gap_chip"
        android:text="@string/ui_send" />
</LinearLayout>
