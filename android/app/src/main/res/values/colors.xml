<?xml version="1.0" encoding="utf-8"?>
<!-- Design tokens, UI.md section 11 (palette version 3; replaces the values of 3.1, 3.2 and 10). One light theme; there is no values-night. -->
<resources>
    <!-- Colour (section 11) -->
    <color name="ink">#15173A</color>
    <color name="ink_2">#5B5E7A</color>
    <color name="ink_3">#8A8DA8</color>
    <color name="page">#FFFFFF</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#F4F4FB</color>
    <color name="bubble_you">#ECEBFB</color>
    <!-- White text on dark shapes -->
    <color name="on_ink">#FFFFFF</color>
    <!-- The one main-action colour: primary button, the owner's single bubble, links, focus, progress -->
    <color name="primary">#4733D6</color>
    <color name="on_primary">#FFFFFF</color>
    <!-- A primary button that cannot be pressed yet; its text stays on_primary -->
    <color name="primary_disabled">#CFC9F5</color>
    <!-- Primary button while pressed: primary about 12% darker -->
    <color name="primary_pressed">#3E2CBB</color>
    <color name="ok">#1F9D6B</color>
    <color name="accent_default">#4733D6</color>
    <!-- White at 22%, for chips on an accent card -->
    <color name="accent_chip">#38FFFFFF</color>
    <!-- Pale button fill; its text is primary -->
    <color name="btn_pale">#ECEBFB</color>
    <!-- Quiet notification card -->
    <color name="quiet">#F1F1F8</color>
    <!-- Body of the running panel -->
    <color name="panel_body">#F4F4FB</color>
    <!-- Scrim under the running panel: black at 15% -->
    <color name="scrim">#26000000</color>

    <!-- Background wash, section 11: white page, a soft area from the top edge. Names kept from version 2. Wash.kt holds the same values. -->
    <color name="wash_warm_base">#FFFFFF</color>
    <!-- Warm (idle): the top area -->
    <color name="wash_warm_peach">#ECEBFA</color>
    <!-- Cool (work, approval, results): the top area and the second area at the upper right -->
    <color name="wash_cool_violet">#E2E4FB</color>
    <color name="wash_cool_middle">#EEE3F8</color>
    <color name="wash_cool_base">#FFFFFF</color>
    <color name="wash_voice_base">#FFFFFF</color>
    <!-- Voice (listening, speaking): the top area -->
    <color name="wash_voice_green">#F1F0FA</color>

    <!-- Launcher icon background, not a UI colour -->
    <color name="ic_launcher_background">#00030F</color>
</resources>
