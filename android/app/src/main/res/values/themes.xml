<?xml version="1.0" encoding="utf-8"?>
<!-- One light theme (UI.md section 7, plan decision 14). There is no values-night. -->
<resources>
    <style name="Theme.OpenCyclon" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorSecondaryContainer">@color/btn_pale</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorOutline">@color/surface_2</item>
        <!-- Cursor, selection handles, checked switches and check boxes, progress (UI.md section 11) -->
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:textColorHighlight">@color/btn_pale</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.App.LinearProgress</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.App.CircularProgress</item>
        <item name="colorSecondary">@color/ink_2</item>
        <item name="colorSurface">@color/page</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.OpenCyclon.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.OpenCyclon.AlertDialog</item>
    </style>

    <!-- Same as the base; the name stays because the manifest and upstream screens use it -->
    <style name="Theme.OpenCyclon.NoActionBar" />

    <style name="Theme.OpenCyclon.Settings">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.OpenCyclon.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorSecondaryContainer">@color/btn_pale</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorOutline">@color/surface_2</item>
        <!-- Cursor, selection handles, checked switches and check boxes, progress (UI.md section 11) -->
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:textColorHighlight">@color/btn_pale</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.App.LinearProgress</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.App.CircularProgress</item>
        <item name="colorSurface">@color/page</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.OpenCyclon.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.OpenCyclon.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.OpenCyclon.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorSurface">@color/page</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- Button style that respects android:background drawable -->
    <style name="OpenCyclon.Button.Custom" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Primary button: primary pill with on_primary text, 52 dp high, 32 dp side padding (UI.md sections 10 and 11) -->
    <style name="Widget.App.Button.Primary" parent="OpenCyclon.Button.Custom">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_h</item>
        <item name="android:paddingEnd">@dimen/button_padding_h</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@null</item>
    </style>

    <!-- Pale button: the same size, btn_pale fill, primary text -->
    <style name="Widget.App.Button.Pale" parent="Widget.App.Button.Primary">
        <item name="android:background">@drawable/bg_btn_pale</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Chip: surface_2 pill, 32 dp, label text in ink. For a TextView. -->
    <style name="Widget.App.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:paddingStart">@dimen/chip_padding_h</item>
        <item name="android:paddingEnd">@dimen/chip_padding_h</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Card: surface, radius 16 dp, card shadow. For a container view. -->
    <style name="Widget.App.Card" parent="">
        <item name="android:background">@drawable/bg_card_surface</item>
        <item name="android:padding">@dimen/padding_card</item>
        <item name="android:elevation">@dimen/elevation_card</item>
        <!-- ponytail: Android shadows cannot set y offset and blur; low-alpha shadow colours approximate "y 4 dp, blur 16 dp, black at 8%" -->
        <item name="android:outlineSpotShadowColor">#33000000</item>
        <item name="android:outlineAmbientShadowColor">#14000000</item>
    </style>

    <!-- Progress (UI.md section 11): primary on surface_2 -->
    <style name="Widget.App.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/surface_2</item>
    </style>

    <style name="Widget.App.CircularProgress" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/surface_2</item>
    </style>
</resources>
