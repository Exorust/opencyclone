<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ai.opencyclone">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Heads-up the pairing-code notification even when our process is backgrounded/frozen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Let the user exempt us from battery optimization so aggressive OEM freezers
         (e.g. ColorOS HansManager) are less likely to suspend the pairing service -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The app switches the accessibility and notification-listener settings itself (granted by setup.sh) -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Pinned shortcuts for built apps on older launchers that use the broadcast fallback -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Package visibility: allows list_apps to discover all installed apps (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- AndroidSpeechInputEngine: the phone's speech recognition services (never our own stub) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- FirstRunActivity: installed messaging apps for the allow-list -->
        <package android:name="com.whatsapp" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.google.android.apps.messaging" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenCyclone">

        <activity
            android:name=".ui.ControlPanelActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenCyclone.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher shortcut "Ask" (F1, one touch) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Optional home mode (plan decision 10, lane P1): disabled until the owner switches it on in Set up -->
        <activity-alias
            android:name=".ui.HomeAlias"
            android:targetActivity=".ui.ControlPanelActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.ViewActivity"
            android:exported="false"
            android:label="OpenCyclone View"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenCyclone.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OpenCyclone.Settings" />

        <activity
            android:name=".ui.MemoryActivity"
            android:exported="false"
            android:label="Memory"
            android:theme="@style/Theme.OpenCyclone.NoActionBar" />

        <activity
            android:name=".backend.SetupActivity"
            android:exported="false"
            android:label="Backend Setup"
            android:configChanges="screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenCyclone.NoActionBar" />

        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ai_phone_control" />
        </service>

        <service
            android:name=".accessibility.VdAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name=".backend.BinderExchangeProvider"
            android:authorities="${applicationId}.binder_exchange"
            android:exported="true" />

        <service
            android:name=".backend.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".proactive.NotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Approve and Reject buttons of the approval card -->
        <receiver
            android:name=".gate.ApprovalReceiver"
            android:exported="false" />

        <!-- "Do this" and Dismiss buttons of the proposal card -->
        <receiver
            android:name=".tasks.ProposalReceiver"
            android:exported="false" />

        <!-- Edit button of the approval card -->
        <activity
            android:name=".gate.EditActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- One built app; opened from its home-screen shortcut and the "Open" action in the chat -->
        <activity
            android:name=".miniapp.MiniAppActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- A received app file (F9, lane L9): "Open with" and share only; checked before anything is stored.
             Not shown over the lock screen. -->
        <activity
            android:name=".miniapp.ReceivedAppActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <!-- Widget draft page (F16): not exported -->
        <activity
            android:name=".ui.widgets.WidgetDraftActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- Integrations screen (F10) -->
        <activity
            android:name=".integrations.IntegrationsActivity"
            android:exported="false"
            android:label="Integrations"
            android:theme="@style/Theme.OpenCyclone.NoActionBar" />

        <!-- First-run screen (F12) -->
        <activity
            android:name=".ui.FirstRunActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OpenCyclone">
            <!-- Return from the browser after "Sign in with ChatGPT/OpenRouter" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencyclone" android:host="signed-in" />
            </intent-filter>
        </activity>

        <!-- Linear start on the first open (lane S1) -->
        <activity
            android:name=".ui.start.StartActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone.NoActionBar" />

        <!-- Privacy screen (F13.1) -->
        <activity
            android:name=".ui.PrivacyActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone" />

        <!-- Model screen: choose the model of the connection -->
        <activity
            android:name=".ui.screens.ModelSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone" />

        <!-- Notification rules screen (F6) -->
        <activity
            android:name=".ui.RulesActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone" />

        <!-- Plain list behind a long press on the greeting (plan decision 9) -->
        <activity
            android:name=".ui.screens.MoreActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone" />

        <!-- The record of one task (F15.2), opened from the history page. -->
        <activity
            android:name=".ui.history.TaskRecordActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone.NoActionBar" />

        <!-- Quick-settings tile "Ask" (F1, one touch) -->
        <service
            android:name=".ui.QuickAskTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/h_quick_ask_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Listening and speaking screen (F1, lane L5); shown over the lock screen, sends only after unlock -->
        <activity
            android:name=".ui.voice.ListeningActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <!-- Voice settings (F17, lane F17): the recognizer choice, models on this phone, the internet service -->
        <activity
            android:name=".ui.screens.VoiceSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenCyclone" />

        <!-- Assistant role (F1.5, lane P1): holding power shows a session that opens the listening screen -->
        <service
            android:name=".assist.AssistService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".assist.AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required by the assistant role; answers every caller with an error and never records -->
        <service
            android:name=".assist.StubRecognitionService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
