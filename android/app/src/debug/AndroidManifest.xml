<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. The walk harness receiver: only a sender holding DUMP (the adb shell user) can call it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="ai.opencyclon.debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.opencyclon.debug.CMD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
