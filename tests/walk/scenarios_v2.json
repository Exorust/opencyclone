  "widget_build_draft": {
    "description": "F16.2 steps 1-3: confirm the sources, build, the draft card; a tap opens the draft page.",
    "texts": [
      {
        "text": "{\"name\":\"Lingo streak\",\"size\":\"small\",\"sources\":[\"app:<LINGO_ID>\",\"history\"]}"
      },
      {
        "text": "<html><head><meta name=\"accent\" content=\"#4733D6\"><meta name=\"sources\" content=\"app:LINGO_ID,history\"><title>Lingo streak</title></head><body><div class=\"label\">Lingo streak</div><div class=\"big\" id=\"s\">-</div><div class=\"row\"><span class=\"label\">Tasks today</span><span class=\"value\" id=\"t\">-</span></div><script>phone.onrefresh=function(){phone.read('app:LINGO_ID').then(function(d){document.getElementById('s').textContent=d&&d.data&&d.data.streak!=null?d.data.streak:'-'});phone.read('history').then(function(h){document.getElementById('t').textContent=h?h.today:'-'});};phone.onrefresh();</script></body></html>"
      }
    ],
    "steps": [
      {
        "seed_app": {
          "name": "Lingo",
          "data": {
            "streak": 4
          }
        }
      },
      {
        "load": true
      },
      {
        "mark": true
      },
      {
        "start": "Make a widget that shows my Lingo streak and how many tasks I ran today"
      },
      {
        "wait_row": {
          "kind": "CONFIRM",
          "state": "OPEN",
          "text_contains": "This widget will read:",
          "action_word": "Build it"
        },
        "timeout": 30
      },
      {
        "expect_row": {
          "kind": "CONFIRM",
          "text_contains": "your app Lingo"
        }
      },
      {
        "confirm": {
          "item": "last",
          "yes": true
        }
      },
      {
        "wait_row": {
          "kind": "RESULT",
          "action_word": "widget-draft",
          "text": "Your widget draft is ready"
        },
        "timeout": 120
      },
      {
        "confirm": {
          "item": "draft",
          "yes": true
        }
      },
      {
        "expect_tasks": {},
        "count": 0
      }
    ]
  },
