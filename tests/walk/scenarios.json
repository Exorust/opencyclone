{
  "_format": [
    "One object per scenario, keyed by name. Fields:",
    "  description  what the scenario walks.",
    "  start        the owner's request, sent with the 'start' command (goes through AgentService.startAgent).",
    "  notify       {package, title, text}: fed to the notification pipeline instead of a request.",
    "  tool_calls   ordered streamed replies for the agent. Each is {tool_call: {...}} with phone_action",
    "               arguments exactly as in llm/ToolSchema.kt (thought, action_type, x, y, app_name, question, ...).",
    "               An optional 'target' ({text|desc|class, clickable, index}) makes the mock server fill x and y",
    "               (0-1000) with the centre of that element in the view tree the app sent with the request.",
    "  texts        ordered non-streamed replies (triage, app builder): {text: '...'} or",
    "               {triage: [{match: {title, package}, result, goal}]}.",
    "  on_hold      what the harness does when an approval waits: approve, reject, edit, or wait (stop and",
    "               leave it to the PM). try_approve_first: send approve before on_hold and record the answer.",
    "  answer       sent with 'answer' when the engine waits for the owner (ask_user).",
    "  edit_text    the correction for on_hold = edit.",
    "  end_state    the task state that ends the run (default: done, failed or cancelled).",
    "  expect       approval (null = no hold), approve_refused, task {origin, state, result, goal},",
    "               counters_delta {sent, pressed, touched}, question (substring), model_saw (substring of a",
    "               request the mock received), script_used_up (true = every scripted tool call was used).",
    "  F18 additions:",
    "  target.number true  the mock fills 'index' with the element's number from the list (a tap by number)",
    "               instead of x and y. A literal 'index' in tool_call taps that number as it is.",
    "  delay_ms     on a tool-call entry: the mock waits that long before it answers (a slow model).",
    "  expect.steps a list of step facts from the state's 'steps' (the last task); each must match one step:",
    "               every key equal (action, by_number, number, label, feedback, success), and",
    "               wait_ms_min / wait_ms_max bound the step's quiet-screen wait.",
    "  counters_delta also takes moved, slow, still (the test app's F18 screens)."
  ],
  "send_approve": {
    "description": "F5: open the test app chat, tap the labelled Send button; the task is held, Approve sends once. The first finish gets one more look (F18.3).",
    "start": "Open Gate Test, open the chat with Alex and tap Send",
    "tool_calls": [
      {
        "tool_call": {
          "thought": "Open the test app",
          "action_type": "open_app",
          "app_name": "Gate Test"
        }
      },
      {
        "tool_call": {
          "thought": "Open the chat",
          "action_type": "tap"
        },
        "target": {
          "text": "Chat",
          "clickable": true
        }
      },
      {
        "tool_call": {
          "thought": "Tap Send",
          "action_type": "tap"
        },
        "target": {
          "text": "Send",
          "clickable": true
        }
      },
      {
        "tool_call": {
          "thought": "Tapped Send",
          "action_type": "finish"
        }
      },
      {
        "tool_call": {
          "thought": "Sent the message to Alex",
          "action_type": "finish"
        }
      }
    ],
    "on_hold": "approve",
    "expect": {
      "approval": {
        "reason": "COMMIT_WORD",
        "label": "SEND",
        "title": "Send in Gate Test to Alex",
        "package": "ai.opencyclone.testapp",
        "approve_offered": true
      },
      "task": {
        "origin": "user",
        "state": "done",
        "result": "Sent the message to Alex"
      },
      "counters_delta": {
        "sent": 1,
        "pressed": 0
      },
      "script_used_up": true
    }
  },
